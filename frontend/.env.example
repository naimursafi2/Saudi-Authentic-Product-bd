# Base URL of the backend API (including the /api/v1 prefix). Defaults to
# http://localhost:5000/api/v1 if unset, which matches the backend's default
# PORT/API_PREFIX for local development.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Google Sign-In ("Continue with Google"). Public client identifier, not a
# secret. Leave blank to hide the button. Must match the backend's
# GOOGLE_CLIENT_ID — see backend/.env.example for how to obtain one.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
