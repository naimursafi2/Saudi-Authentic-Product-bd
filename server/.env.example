# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Frontend origin(s) allowed to call this API (comma separated for multiple)
CLIENT_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/saudi_authentic_product

# Redis — stores registration email-verification OTPs with a 5-minute TTL
# (nothing OTP-related is kept in MongoDB). Format:
#   redis://default:<password>@<host>:<port>   (use rediss:// for TLS)
# Leave blank in local dev without Redis: an in-process fallback is used,
# which is fine for one dev server but NOT for production.
REDIS_URL=

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=15d
COOKIE_DOMAIN=localhos t

# Cloudinary (product / employee image uploads)
# Leave blank until you have credentials — the upload endpoints will return a
# clear 503 error until these are set, everything else works without them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (staff notifications, password reset, order confirmation, salary
# payment notices). Leave blank until configured — email sending becomes a
# silent no-op (logged, never blocks the request) until these are set.
# SMTP_SERVICE is a nodemailer "service" shorthand, e.g. "gmail".
SMTP_SERVICE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Sign-In ("Continue with Google"). Leave blank until configured —
# POST /auth/google returns a clear 503 and the frontend button hides itself
# until this is set. Create an OAuth 2.0 Client ID (Web application) in
# Google Cloud Console -> APIs & Services -> Credentials, and add your
# frontend origin (e.g. http://localhost:3000) as an Authorized JavaScript
# origin. This value is a public client identifier, not a secret — the SAME
# value must also be set as NEXT_PUBLIC_GOOGLE_CLIENT_ID in frontend/.env.
GOOGLE_CLIENT_ID=

# SMS gateway (delivery-agent OTP). No provider is integrated yet — leave
# blank and the delivery OTP still works via email + the order tracking page,
# with the SMS send becoming a logged no-op (see src/config/sms.ts). Fill
# these in once a provider (Twilio, SSL Wireless, etc.) is chosen; verify the
# actual request shape against that provider's docs first.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# SSLCommerz online payment (cards, mobile banking, net banking). Leave the
# store id/password blank and online payment is hidden at checkout — cash on
# delivery keeps working. These are SECRETS: never commit real values, never
# expose them to the frontend, never log them. Get them from your SSLCommerz
# merchant panel (sandbox credentials from https://developer.sslcommerz.com).
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# false = sandbox (test money), true = live gateway.
SSLCOMMERZ_IS_LIVE=false
# Public URL of THIS API (no /api/v1), used to build SSLCommerz's success /
# fail / cancel / IPN callback URLs. Leave blank locally (defaults to
# http://localhost:PORT); in production set it to the deployed backend URL,
# e.g. https://your-api.onrender.com. After payment the customer is sent to
# the first CLIENT_ORIGIN's /checkout/payment/{success,failed,cancelled}.
SERVER_PUBLIC_URL=

# Shared secret with the frontend's `/api/revalidate` route (Next.js).
# Leave blank until configured — nav link / category / homepage section /
# site settings changes just fall back to the frontend's own long safety-net
# cache window instead of showing up instantly; everything else keeps
# working. Set this to the SAME long random string as REVALIDATE_SECRET in
# client/.env.local (dev) or the frontend's Vercel env vars (production).
REVALIDATE_SECRET=

# Bootstrap super admin (used by `npm run seed`)
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@saudiauthenticproduct.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
