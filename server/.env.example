# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Frontend origin(s) allowed to call this API (comma separated for multiple)
CLIENT_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/saudi_authentic_product

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=15d
COOKIE_DOMAIN=localhos t

# Cloudinary (product / employee image uploads)
# Leave blank until you have credentials — the upload endpoints will return a
# clear 503 error until these are set, everything else works without them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (staff notifications, password reset, order confirmation, salary
# payment notices). Leave blank until configured — email sending becomes a
# silent no-op (logged, never blocks the request) until these are set.
# SMTP_SERVICE is a nodemailer "service" shorthand, e.g. "gmail".
SMTP_SERVICE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Sign-In ("Continue with Google"). Leave blank until configured —
# POST /auth/google returns a clear 503 and the frontend button hides itself
# until this is set. Create an OAuth 2.0 Client ID (Web application) in
# Google Cloud Console -> APIs & Services -> Credentials, and add your
# frontend origin (e.g. http://localhost:3000) as an Authorized JavaScript
# origin. This value is a public client identifier, not a secret — the SAME
# value must also be set as NEXT_PUBLIC_GOOGLE_CLIENT_ID in frontend/.env.
GOOGLE_CLIENT_ID=

# SMS gateway (delivery-agent OTP). No provider is integrated yet — leave
# blank and the delivery OTP still works via email + the order tracking page,
# with the SMS send becoming a logged no-op (see src/config/sms.ts). Fill
# these in once a provider (Twilio, SSL Wireless, etc.) is chosen; verify the
# actual request shape against that provider's docs first.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# bKash Tokenized Checkout. Leave blank until real merchant credentials are
# provisioned — creating or verifying a bKash payment returns a clear 503 and
# the storefront hides the bKash option until these are set; everything else
# (including cash on delivery) keeps working. These are SECRETS: never commit
# real values, never expose them to the frontend, never log them.
BKASH_BASE_URL=https://your-bkash-base-url
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret

# Bootstrap super admin (used by `npm run seed`)
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@saudiauthenticproduct.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
