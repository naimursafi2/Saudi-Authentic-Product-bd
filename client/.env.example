# Base URL of the backend API (including the /api/v1 prefix). Defaults to
# http://localhost:5000/api/v1 if unset, which matches the backend's default
# PORT/API_PREFIX for local development.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Google Sign-In ("Continue with Google"). Public client identifier, not a
# secret. Leave blank to hide the button. Must match the backend's
# GOOGLE_CLIENT_ID — see server/.env.example for how to obtain one.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Shared secret the backend uses to call this app's `/api/revalidate` route
# after an admin saves a nav link / category / homepage section / site
# setting, so the change shows up for visitors instantly instead of waiting
# out the long safety-net cache window (see (site)/layout.tsx). NOT public —
# do not prefix with NEXT_PUBLIC_. Leave blank to disable (falls back to the
# safety-net window only). Set this to the SAME long random string as
# REVALIDATE_SECRET in server/.env (or the backend's Render env vars).
REVALIDATE_SECRET=
