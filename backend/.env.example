# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Frontend origin(s) allowed to call this API (comma separated for multiple)
CLIENT_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/saudi_authentic_product

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=localhost

# Cloudinary (product / employee image uploads)
# Leave blank until you have credentials — the upload endpoints will return a
# clear 503 error until these are set, everything else works without them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (staff notifications, password reset, order confirmation, salary
# payment notices). Leave blank until configured — email sending becomes a
# silent no-op (logged, never blocks the request) until these are set.
# SMTP_SERVICE is a nodemailer "service" shorthand, e.g. "gmail".
SMTP_SERVICE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Bootstrap super admin (used by `npm run seed`)
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@saudiauthenticproduct.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
