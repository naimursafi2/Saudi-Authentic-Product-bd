# Shared root .gitignore for both server/ and client/.
# Patterns are unanchored so they match at any depth in either app.

# Dependencies
node_modules/

# Environment variables — never commit real secrets
.env
.env.local
.env.*.local

# Build output
dist/
build/
out/
.next/

# TypeScript incremental build cache
*.tsbuildinfo

# Next.js
next-env.d.ts
.vercel

# Testing / coverage
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.vscode/*
!.vscode/extensions.json
.idea/
